{
  "name": "shahin-traders",
  "version": "0.1.0",
  "private": true,
  "description": "Inventory and Customer Ledger System for Shahin Traders",
  "author": "Shahin Traders",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "desktop": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "clean": "rimraf dist",
    "dist": "npm run clean && electron-builder"
  },
  "build": {
    "appId": "com.shahin-traders.app",
    "productName": "Shahin Traders",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "**/*",
      "main.js",
      ".next/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.11.0",
    "mongoose": "^9.5.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  }
}
